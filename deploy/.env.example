# docker compose 变量（会被 bootstrap 脚本自动生成 deploy/.env）

# 是否用 docker 里的 nginx 做入口
#   1 = 用（服务器没有别的 web 服务器时）
#   0 = 不用（宝塔/1Panel 等已经占用 80 端口，由面板的 Nginx 做入口）
USE_DOCKER_NGINX=1

# 仅当 USE_DOCKER_NGINX=1 时生效：docker nginx 对外端口，80 就是 http://服务器IP/
WEB_PORT=80
# 后端端口只绑定 127.0.0.1，给服务器本机调试、面板 Nginx 反代用
APP_PORT=9501
DB_ROOT_PASSWORD=change-me
DB_DATABASE=mineadmin
# 仅绑定 127.0.0.1，改端口只是为了避免和宿主机已有服务冲突
# 宝塔一般自带 MySQL(3306) / Redis(6379)，所以这里用 13306/16379 错开
DB_EXPOSE_PORT=13306
REDIS_EXPOSE_PORT=16379
