# 页面标题
VITE_APP_TITLE = MineAdmin
# 端口
VITE_APP_PORT = 2888
# 应用根路径
VITE_APP_ROOT_BASE = /
# 接口请求地址，会设置到 axios 的 baseURL 参数上
VITE_APP_API_BASEURL = http://hyperf:9501
# 路由模式: history 和 hash 两种，默认hash，带#号那种
VITE_APP_ROUTE_MODE = hash

# 存储前缀
VITE_APP_STORAGE_PREFIX = mine_

# 是否开启代理
VITE_OPEN_PROXY = true
# 代理前缀标识
VITE_PROXY_PREFIX = /prod

# 是否在打包时生成 sourcemap
VITE_BUILD_SOURCEMAP = false
# 是否在打包后生成存档，支持 zip 和 tar
VITE_BUILD_ARCHIVE =
# 是否生成 .gz/.br 预压缩文件。
# dist 会提交进 Git，预压缩会让文件数翻三倍且每次构建都产生新 blob，
# 所以这里关掉，压缩交给 Nginx 的 gzip 实时处理。
# 如果你确认服务器 Nginx 有 gzip_static / brotli_static 模块，可以改回 gzip,brotli。
VITE_BUILD_COMPRESS =
